{
  "name": "@orlynx/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace=@orlynx/shared",
    "prebuild": "npm run build --workspace=@orlynx/shared",
    "pretest": "npm run build --workspace=@orlynx/shared",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.js",
    "e2e": "node test/e2e.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:provider-runtime": "node scripts/verify-provider-runtime.mjs",
    "start:orchestrator": "node dist/orchestrator-worker.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@orlynx/shared": "*",
    "@vercel/sandbox": "^1.4.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "multer": "^2.4.0",
    "uuid": "^14.0.2",
    "ws": "^8.18.0",
    "ai": "6.0.168",
    "@ai-sdk/openai": "3.0.88",
    "@ai-sdk/openai-compatible": "2.0.41",
    "@ai-sdk/anthropic": "3.0.111",
    "@ai-sdk/google": "3.0.73"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.12.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
