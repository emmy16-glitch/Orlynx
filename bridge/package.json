{
  "name": "@orlynx/bridge",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && cp src/mini-swe-runtime.py dist/mini-swe-runtime.py",
    "postbuild": "if [ \"${ORLYNX_INSTALL_MINI_SWE:-0}\" = \"1\" ]; then bash ../scripts/install-mini-swe-runtime.sh; fi",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@cline/agents": "0.0.90",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
