{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/bridge", "destination": "/api/bridge" },
    { "source": "/v1/:apiRoute*", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.mjs": { "maxDuration": 300 },
    "api/bridge.mjs": { "maxDuration": 300 }
  }
}
