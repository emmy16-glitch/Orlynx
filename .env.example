PORT=4000
ORLYNX_DATA_DIR=./data
ORLYNX_MAX_UPLOAD_MB=15
# Required for GitHub App installation-based repository access.
ORLYNX_PUBLIC_URL=https://orlynx.example.com
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# OpenCode server API. It must see the same imported repository filesystem.
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
OPENCODE_PROJECTS_ROOT=./data/repos
OPENCODE_AGENT=build
OPENCODE_MODEL=
OPENCODE_RUN_TIMEOUT_MS=1800000
# Codespaces is intentionally unavailable without an OpenCode server connected to
# the active Codespace's forwarded port. No local workspace is substituted.
