PORT=4000
ORLYNX_DATA_DIR=./data
ORLYNX_MAX_UPLOAD_MB=15
# Required for GitHub App installation-based repository access.
ORLYNX_PUBLIC_URL=https://orlynx.example.com
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Production control-plane durability and credential encryption.
DATABASE_URL=
# Generate with: openssl rand -base64 32
ORLYNX_CREDENTIAL_ENCRYPTION_KEY=
# Generate independently with: openssl rand -base64 48
ORLYNX_BRIDGE_SIGNING_SECRET=
# Persistent bootstrap worker (see runtime-worker/Dockerfile).
# On Vercel this is optional: Orlynx uses an ephemeral Vercel Sandbox by default.
ORLYNX_RUNTIME_WORKER_URL=https://runtime-worker.example.com
ORLYNX_RUNTIME_WORKER_TOKEN=
# Hosted providers other than Vercel should set this to 1 so missing durable
# storage fails closed instead of falling back to local JSON.
ORLYNX_HOSTED_PRODUCTION=
# Use "sandbox" for Vercel Sandbox or "local" when the host has the GitHub CLI.
ORLYNX_BOOTSTRAP_MODE=
# Optional, deliberately gated live E2E branch endpoint.
ORLYNX_E2E_ENABLED=false

# Local development only. Production OpenCode is workspace-scoped and reached
# through the authenticated bridge; Vercel ignores this global URL.
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
OPENCODE_PROJECTS_ROOT=./data/repos
OPENCODE_AGENT=build
OPENCODE_MODEL=
OPENCODE_RUN_TIMEOUT_MS=1800000
# Orlynx AI defaults (unified layer; engine stays OpenCode).
# Priority: per-task override → session choice → project default → these values.
# ORLYNX_DEFAULT_MODEL=openai/gpt-5
# ORLYNX_DEFAULT_MODE=build
# ORLYNX_DEFAULT_PERMISSION=ask-first
