PORT=4000
ORLYNX_DATA_DIR=./data
ORLYNX_MAX_UPLOAD_MB=15
# Required for GitHub App installation-based repository access.
ORLYNX_PUBLIC_URL=https://your-service.onrender.com
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Production control-plane durability and credential encryption.
DATABASE_URL=
# Generate with: openssl rand -base64 32
ORLYNX_CREDENTIAL_ENCRYPTION_KEY=
# Generate independently with: openssl rand -base64 48
ORLYNX_BRIDGE_SIGNING_SECRET=
# Optional standalone bootstrap worker (see runtime-worker/Dockerfile).
# The Render deployment does not need it: scripts/render-build.sh installs the
# GitHub CLI and ORLYNX_BOOTSTRAP_MODE=local bootstraps Codespaces directly.
ORLYNX_RUNTIME_WORKER_URL=
ORLYNX_RUNTIME_WORKER_TOKEN=
# Required on hosted Node deployments so missing durable storage fails closed.
ORLYNX_HOSTED_PRODUCTION=1
# Render: local. Legacy Vercel Sandbox deployments: sandbox.
ORLYNX_BOOTSTRAP_MODE=local
# Maximum admitted follow-up prompts waiting behind the running task.
ORLYNX_MAX_QUEUED_TASKS=8
# Optional, deliberately gated live E2E branch endpoint.
ORLYNX_E2E_ENABLED=false

# Local development only. Production OpenCode is workspace-scoped and reached
# through the authenticated bridge; hosted production ignores this global URL.
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
OPENCODE_PROJECTS_ROOT=./data/repos
OPENCODE_AGENT=build
OPENCODE_MODEL=
OPENCODE_RUN_TIMEOUT_MS=1800000
# Orlynx AI defaults (unified layer; engine stays OpenCode).
# Priority: per-task override → session choice → project default → these values.
# ORLYNX_DEFAULT_MODEL=openai/gpt-5
# ORLYNX_DEFAULT_MODE=build
# ORLYNX_DEFAULT_PERMISSION=ask-first
