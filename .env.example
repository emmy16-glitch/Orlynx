PORT=4000
ORLYNX_DATA_DIR=./data
ORLYNX_MAX_UPLOAD_MB=15
# Required for GitHub App installation-based repository access.
ORLYNX_PUBLIC_URL=https://your-service.onrender.com
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Production control-plane durability and credential encryption.
DATABASE_URL=
# Generate with: openssl rand -base64 32
ORLYNX_CREDENTIAL_ENCRYPTION_KEY=
# Generate independently with: openssl rand -base64 48
ORLYNX_BRIDGE_SIGNING_SECRET=
# Optional standalone bootstrap worker (see runtime-worker/Dockerfile).
# The Render deployment does not need it: scripts/render-build.sh installs the
# GitHub CLI and ORLYNX_BOOTSTRAP_MODE=local bootstraps Codespaces directly.
ORLYNX_RUNTIME_WORKER_URL=
ORLYNX_RUNTIME_WORKER_TOKEN=
# Required on hosted Node deployments so missing durable storage fails closed.
ORLYNX_HOSTED_PRODUCTION=1
# Preferred execution provider. "auto" uses the warm runner when configured
# and falls back to GitHub Codespaces otherwise.
ORLYNX_WORKSPACE_PROVIDER=auto
# Private HTTPS endpoint for the Orlynx runner manager. Leave empty to keep
# GitHub Codespaces as the execution provider.
ORLYNX_RUNNER_URL=
# Public HTTPS origin used by browser preview links. Can equal
# ORLYNX_RUNNER_URL when that endpoint is publicly reachable.
ORLYNX_RUNNER_PUBLIC_URL=
ORLYNX_RUNNER_TOKEN=
ORLYNX_PREVIEW_TOKEN_TTL_SECONDS=600
# Distributed runner pool. ORLYNX_RUNNER_HOSTS may be JSON:
# [{"id":"runner-eu-1","url":"https://runner-eu-1.example.com","publicUrl":"https://runner-eu-1.example.com","region":"eu","weight":1}]
# or a comma-separated list: runner-a=https://runner-a.example.com,runner-b=https://runner-b.example.com
# If omitted, ORLYNX_RUNNER_URL remains the backward-compatible single-host pool.
ORLYNX_RUNNER_HOSTS=
ORLYNX_RUNNER_GLOBAL_MAX_WORKSPACES=50
ORLYNX_RUNNER_HEALTH_TIMEOUT_MS=2500
ORLYNX_RUNNER_HEALTH_CACHE_MS=5000
ORLYNX_RUNNER_CIRCUIT_FAILURES=3
ORLYNX_RUNNER_CIRCUIT_COOLDOWN_MS=60000
# Per-host runner-manager capacity and lifecycle. A common layout is 5 hosts × 10 active workspaces = 50.
ORLYNX_RUNNER_HOST_ID=
ORLYNX_RUNNER_REGION=
ORLYNX_RUNNER_MAX_WORKSPACES=10
ORLYNX_RUNNER_DRAINING=0
ORLYNX_RUNNER_GIT_CACHE=1
ORLYNX_RUNNER_GIT_CACHE_ROOT=/var/lib/orlynx/git-cache
ORLYNX_RUNNER_CACHE_TIMEOUT_MS=120000
# Docker runner-manager hosts use the browser-ready runtime image by default.
ORLYNX_RUNNER_BROWSER_E2E=1
# Codespaces only prepare Playwright/Chromium when the repository declares it.
ORLYNX_PREWARM_BROWSER_RUNTIME=1
ORLYNX_RUNNER_IDLE_SECONDS=900
ORLYNX_RUNNER_RECLAIM_SECONDS=3600
ORLYNX_RUNNER_CLEANUP_SECONDS=60
# Warm the runner as soon as a repository session opens. Set 0 to disable.
ORLYNX_PREWARM_WORKSPACES=1
# If the warm runner fails, automatically preserve the task by using Codespaces.
ORLYNX_RUNNER_FALLBACK_TO_CODESPACES=1
ORLYNX_RUNNER_CREATE_TIMEOUT_MS=60000
ORLYNX_RUNNER_READY_TIMEOUT_MS=60000
ORLYNX_RUNNER_CONNECT_TIMEOUT_MS=30000

# Optional independent E2B workspace provider/fallback.
# E2B is only selected when explicitly configured or when the primary provider
# fails and this key is present.
E2B_API_KEY=
ORLYNX_E2B_TEMPLATE=base
ORLYNX_E2B_TIMEOUT_MS=3300000
ORLYNX_E2B_READY_TIMEOUT_MS=90000
ORLYNX_E2B_CLONE_TIMEOUT_MS=180000
ORLYNX_E2B_BOOTSTRAP_TIMEOUT_MS=300000

# GitHub Actions verification backend. Orlynx only dispatches existing active
# workflows that explicitly declare workflow_dispatch; it never creates CI in
# a user's repository merely to make this backend available.
ORLYNX_GITHUB_ACTIONS_DISCOVERY_TIMEOUT_MS=90000
ORLYNX_GITHUB_ACTIONS_TIMEOUT_MS=1200000

# Workspace lifecycle orchestration. Use "worker" in production after deploying
# the dedicated background worker; "inline" preserves single-service/local use.
ORLYNX_ORCHESTRATOR_MODE=inline
ORLYNX_ORCHESTRATOR_POLL_MS=1000
ORLYNX_ORCHESTRATOR_BATCH_SIZE=4
ORLYNX_ORCHESTRATOR_LEASE_SECONDS=180
ORLYNX_ORCHESTRATOR_MAX_ATTEMPTS=12

# Codespaces bootstrap remains the fallback provider.
# Render: local. Legacy Vercel Sandbox deployments: sandbox.
ORLYNX_BOOTSTRAP_MODE=local
# Maximum admitted follow-up prompts waiting behind the running task.
ORLYNX_MAX_QUEUED_TASKS=8
# Long-lived queue retention for development environments that are recovering.
ORLYNX_QUEUED_TASK_RETENTION_MS=86400000
# Optional, deliberately gated live E2E branch endpoint.
ORLYNX_E2E_ENABLED=false

# Local development only. Production OpenCode is workspace-scoped and reached
# through the authenticated bridge; hosted production ignores this global URL.
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
OPENCODE_PROJECTS_ROOT=./data/repos
OPENCODE_AGENT=build
OPENCODE_MODEL=
OPENCODE_RUN_TIMEOUT_MS=1800000
# Orlynx AI defaults (unified layer; engine stays OpenCode).
# Priority: per-task override → session choice → project default → these values.
# ORLYNX_DEFAULT_MODEL=openai/gpt-5
# ORLYNX_DEFAULT_MODE=build
# ORLYNX_DEFAULT_PERMISSION=ask-first
